[Unit]
Description=Cafe Management Production Frontend (Next.js)
After=network.target

[Service]
Type=simple
User=astroagent
WorkingDirectory=/var/www/cafe-management/frontend
Environment=NODE_ENV=production
Environment=PORT=4001
ExecStart=/usr/bin/node /var/www/cafe-management/frontend/node_modules/next/dist/bin/next start -p 4001
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
