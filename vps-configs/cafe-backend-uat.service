[Unit]
Description=Cafe Management UAT Backend (Node.js)
After=network.target

[Service]
Type=simple
User=astroagent
WorkingDirectory=/var/www/cafe-management-uat/backend
Environment=NODE_ENV=production
Environment=PORT=6002
ExecStart=/usr/bin/node /var/www/cafe-management-uat/backend/dist/index.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=cafe-backend-uat

[Install]
WantedBy=multi-user.target
