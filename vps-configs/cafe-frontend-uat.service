[Unit]
Description=Cafe Management UAT Frontend (Next.js)
After=network.target

[Service]
Type=simple
User=astroagent
WorkingDirectory=/var/www/cafe-management-uat/frontend
Environment=NODE_ENV=production
Environment=PORT=4321
ExecStart=/usr/bin/node /var/www/cafe-management-uat/frontend/node_modules/next/dist/bin/next start -p 4321
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
